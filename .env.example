# Por padrão o app aponta para o backend em produção (Render) — não precisa
# definir nada para rodar o app normalmente.
#
# Para desenvolver contra um backend rodando na sua máquina (`npm run dev` no
# republica-backend), copie este arquivo para `.env` e descomente a linha
# certa para a plataforma que você está usando:

# Web / iOS Simulator:
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Emulador Android (10.0.2.2 é o alias do host da máquina dentro do emulador):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Dispositivo físico na mesma rede Wi-Fi (troque pelo IP da sua máquina):
# EXPO_PUBLIC_API_URL=http://192.168.0.101:3000
